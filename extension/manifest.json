{
  "manifest_version": 3,
  "name": "Zapisywacz Słów",
  "version": "1.4",
  "description": "Zapisuje i tłumaczy słowa, synchronizuje z bazą danych fiszek.",
  "permissions": [
    "contextMenus",
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://translate.googleapis.com/*",
    "https://zorx-backend.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}